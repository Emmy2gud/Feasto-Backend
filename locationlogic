
import { useEffect } from "react";
import api from "../lib/axios";

export default function RiderLocationTracker({isOnline,isAvailable}) {
  useEffect(() => {
    if (!isOnline || !isAvailable) {
      return;
    }

    if (!navigator.geolocation) {
      console.error("This device does not support GPS location.");
      return;
    }

    const sendLocation = () => {
      navigator.geolocation.getCurrentPosition(
        async (position) => {
          try {
            await api.post("/rider/location", {
              latitude: position.coords.latitude,
              longitude: position.coords.longitude,
            });
          } catch (error) {
            console.error(
              "Location update failed:",
              error.response?.data || error.message
            );
          }
        },
        (error) => {
          console.error("Unable to get location:", error.message);
        },
        {
          enableHighAccuracy: true,
          maximumAge: 5000,
          timeout: 15000,
        }
      );
    };

    // Get the first location immediately.
    sendLocation();

    // Send another location every 10 seconds.
    const intervalId = setInterval(sendLocation, 10000);

    // Stop tracking when the rider goes offline.
    return () => clearInterval(intervalId);
  }, [isOnline, isAvailable]);

  return null;
}




